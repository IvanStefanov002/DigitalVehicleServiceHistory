<?xml version="1.0" encoding="utf-8"?>
<!-- Icon + label tint for the bottom navigation: accent-on-container when selected, muted
     otherwise. Theme attribute references in a ColorStateList need API 23+; minSdk here is 24. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:color="?attr/colorOnPrimaryContainer" />
    <item android:color="?attr/colorOnSurfaceVariant" />
</selector>
