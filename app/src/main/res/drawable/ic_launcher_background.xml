<!--
  Adaptive-icon BACKGROUND layer. Must fill the whole 108x108dp canvas: the launcher crops this to
  whatever mask the device uses (circle, squircle, rounded square) and may parallax-shift it, so
  nothing here may rely on the edges being visible.

  Navy gradient matching the app's dark scheme (see values-night/colors.xml).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108H0z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#FF15304A" />
                <item android:offset="1" android:color="#FF0B1220" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
