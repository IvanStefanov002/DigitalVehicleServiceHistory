<?xml version="1.0" encoding="utf-8"?>
<!-- #avRoot is padded for the system bars / display cutout in AddVehicleActivity.onCreate; without
     that the header's back button is drawn under the status bar and camera cutout, and untappable.

     Structure mirrors activity_add_maintenance.xml — tonal section cards, each headed by an
     accent icon chip, holding outlined TextInputLayouts with floating labels. The three accents
     encode real categories (photo / required / optional), not variety; see CLAUDE.md.
     Field labels are the shared ev_* strings, also used by activity_edit_vehicle.xml, and the
     start icons are the same ones the detail screen puts on its spec rows, so a field looks the
     same wherever the user meets it. -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/avRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: back button + title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                app:tint="?attr/colorOnSurface"
                android:contentDescription="@string/back" />

            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/av_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/av_intro"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp" />

        <!-- ============ Section 1: photo — own upload or the default image ============ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:cardBackgroundColor="?attr/colorSurfaceContainer">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:padding="7dp"
                        android:background="@drawable/bg_icon_chip"
                        android:backgroundTint="@color/accent_1_bg"
                        android:src="@drawable/ic_car"
                        app:tint="@color/accent_1_fg"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="@string/av_photo_section"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Two mutually exclusive modes; selectionRequired stops the user from
                     de-selecting both and leaving the panel in no state at all. -->
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/togglePhotoMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnModeDefault"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/av_photo_mode_default" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnModeUpload"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/av_photo_mode_upload" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <ImageView
                    android:id="@+id/imgVehiclePhoto"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:src="@drawable/car_placeholder"
                    android:scaleType="centerCrop"
                    android:background="@drawable/circle_background"
                    android:backgroundTint="?attr/colorSurfaceContainerHighest"
                    android:padding="4dp"
                    android:contentDescription="@string/av_photo_cd" />

                <!-- Only shown in upload mode; the hint takes its place in default mode. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickPhoto"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"
                    android:text="@string/av_photo_pick"
                    app:icon="@drawable/ic_add"
                    app:iconGravity="textStart" />

                <TextView
                    android:id="@+id/txtPhotoHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_horizontal"
                    android:text="@string/av_photo_hint_default"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ Section 2: the four fields saveVehicle() requires ============ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:cardBackgroundColor="?attr/colorSurfaceContainer">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:padding="7dp"
                        android:background="@drawable/bg_icon_chip"
                        android:backgroundTint="@color/accent_2_bg"
                        android:src="@drawable/ic_plate"
                        app:tint="@color/accent_2_fg"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="@string/av_section_main"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Type comes first in this section because it is what the rest of the form is
                     about: it decides how the vehicle is grouped on the Автопарк tab and whether the
                     oil advisor will answer for it. Exposed dropdown, seeded in onCreate for the
                     same reason as the fuel picker below (an autocomplete starts with nothing
                     selected, unlike the Spinner this idiom replaced). -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="@string/ev_type"
                    app:startIconDrawable="@drawable/ic_car">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/ddVehicleType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/ev_make"
                    app:startIconDrawable="@drawable/ic_car"
                    app:placeholderText="@string/av_eg_make">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtMake"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:textSize="15sp"
                        android:autofillHints="" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/ev_model"
                    app:startIconDrawable="@drawable/ic_car"
                    app:placeholderText="@string/av_eg_model">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtModel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textSize="15sp"
                        android:autofillHints="" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Year and plate share a row: a 4-digit year next to a full-width field wastes
                     most of the line, and pairing them keeps the required block compact. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/ev_year"
                        app:startIconDrawable="@drawable/ic_year"
                        app:placeholderText="@string/av_eg_year">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtYear"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="4"
                            android:textSize="15sp"
                            android:autofillHints="" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.4"
                        android:layout_marginStart="12dp"
                        android:hint="@string/ev_plate"
                        app:startIconDrawable="@drawable/ic_plate"
                        app:placeholderText="@string/av_eg_plate">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtPlate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapCharacters"
                            android:textSize="15sp"
                            android:autofillHints="" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ Section 3: everything with a usable default ============ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:cardBackgroundColor="?attr/colorSurfaceContainer">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:padding="7dp"
                        android:background="@drawable/bg_icon_chip"
                        android:backgroundTint="@color/accent_3_bg"
                        android:src="@drawable/ic_mileage"
                        app:tint="@color/accent_3_fg"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="@string/av_section_extra"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="@string/ev_mileage"
                    app:startIconDrawable="@drawable/ic_mileage"
                    app:suffixText="@string/av_km"
                    app:helperText="@string/av_mileage_helper">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtMileage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textSize="15sp"
                        android:autofillHints="" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Exposed dropdown, not a bare Spinner, so it matches the outlined fields around
                     it. AddVehicleActivity has to seed the first entry itself — unlike a Spinner,
                     an autocomplete starts with nothing selected. -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/ev_fuel"
                    app:startIconDrawable="@drawable/ic_fuel">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/ddFuelType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/ev_vin"
                    app:startIconDrawable="@drawable/ic_vin"
                    app:helperText="@string/av_optional"
                    app:counterEnabled="true"
                    app:counterMaxLength="17">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtVin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapCharacters"
                        android:maxLength="17"
                        android:textSize="15sp"
                        android:autofillHints="" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/ev_color"
                    app:startIconDrawable="@drawable/ic_color"
                    app:helperText="@string/av_optional">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtColor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:textSize="15sp"
                        android:autofillHints="" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveVehicle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="@string/ev_save"
            app:icon="@drawable/ic_check"
            app:iconGravity="textStart" />
    </LinearLayout>
</ScrollView>
