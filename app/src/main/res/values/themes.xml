<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Single app theme for BOTH light and dark.

      Every color below points at an @color/scheme_* name that is defined twice — once in
      values/colors.xml (light) and once in values-night/colors.xml (dark navy + cyan). Android
      picks the right file for the current mode, so this one style block skins both. That's why
      there is no values-night/themes.xml override: duplicating the style there would mean
      maintaining the mapping twice.
    -->
    <style name="Base.Theme.MaintenanceApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/scheme_primary</item>
        <item name="colorOnPrimary">@color/scheme_on_primary</item>
        <item name="colorPrimaryContainer">@color/scheme_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/scheme_on_primary_container</item>

        <item name="colorSecondary">@color/scheme_secondary</item>
        <item name="colorOnSecondary">@color/scheme_on_secondary</item>
        <item name="colorSecondaryContainer">@color/scheme_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/scheme_on_secondary_container</item>

        <item name="colorTertiary">@color/scheme_tertiary</item>
        <item name="colorOnTertiary">@color/scheme_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/scheme_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/scheme_on_tertiary_container</item>

        <item name="colorError">@color/scheme_error</item>
        <item name="colorOnError">@color/scheme_on_error</item>
        <item name="colorErrorContainer">@color/scheme_error_container</item>
        <item name="colorOnErrorContainer">@color/scheme_on_error_container</item>

        <item name="android:colorBackground">@color/scheme_background</item>
        <item name="colorOnBackground">@color/scheme_on_background</item>

        <item name="colorSurface">@color/scheme_surface</item>
        <item name="colorOnSurface">@color/scheme_on_surface</item>
        <item name="colorSurfaceVariant">@color/scheme_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/scheme_on_surface_variant</item>

        <!-- Container tones drive Material 3 component backgrounds (cards, bottom nav, menus). -->
        <item name="colorSurfaceContainerLowest">@color/scheme_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/scheme_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/scheme_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/scheme_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/scheme_surface_container_highest</item>

        <item name="colorSurfaceInverse">@color/scheme_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/scheme_inverse_on_surface</item>

        <item name="colorOutline">@color/scheme_outline</item>
        <item name="colorOutlineVariant">@color/scheme_outline_variant</item>

        <!-- System bars: content draws edge-to-edge (targetSdk 36), so only the icon contrast is
             ours to set. @bool flips per mode from values(-night)/bools.xml. -->
        <item name="android:windowLightStatusBar">@bool/window_light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/window_light_system_bars</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- Applied to every BottomNavigationView without touching activity_main.xml. -->
        <item name="bottomNavigationStyle">@style/Widget.App.BottomNav</item>
    </style>

    <style name="Theme.MaintenanceApp" parent="Base.Theme.MaintenanceApp" />

    <!-- Bottom nav: the stock M3 active pill uses the secondary container (slate); point it at the
         primary container instead so the cyan accent is what marks the selected tab. -->
    <style name="Widget.App.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="itemActiveIndicatorStyle">@style/Widget.App.BottomNav.ActiveIndicator</item>
        <item name="itemIconTint">@color/bottom_nav_item</item>
        <item name="itemTextColor">@color/bottom_nav_item</item>
    </style>

    <style name="Widget.App.BottomNav.ActiveIndicator"
        parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?attr/colorPrimaryContainer</item>
    </style>

    <!-- Field label on the add-service form. -->
    <style name="AmLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Thin divider between spec rows on the vehicle detail screen. -->
    <style name="Divider.Spec" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">?attr/colorOutlineVariant</item>
    </style>

    <!-- Rounded corners for vehicle list thumbnails (ShapeableImageView). -->
    <style name="ShapeAppearanceOverlay.Vehicle.Thumbnail" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <!-- Circular crop for the profile avatar (ShapeableImageView). Needed since the placeholder
         became a photo: the old vector glyph was transparent outside its circle, so an unclipped
         ImageView looked round by accident. A real photo does not, and centerCrop would have drawn
         a square over the circular background. -->
    <style name="ShapeAppearanceOverlay.Avatar" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Small all-caps label above a value (service-type card, spec blocks). -->
    <style name="Label.Overline" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
