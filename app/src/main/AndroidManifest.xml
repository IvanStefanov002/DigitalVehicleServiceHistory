<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- internet access -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Service-due reminders. Runtime-requested on Android 13+; auto-granted below that. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MaintenanceApp">

        <!-- ACTIVITIES -->
        <!-- LoginActivity is now the main screen which loads at start-up -->
        <activity android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".RegisterActivity"
            android:exported="false" />

        <activity android:name=".MainActivity"
            android:exported="true" />

        <activity android:name=".AddVehicleActivity"
            android:exported="false"/>

        <activity android:name=".VehicleDetailActivity"
            android:exported="false"/>

        <activity android:name=".AddMaintenanceActivity"
            android:exported="false"/>

        <activity android:name=".OilRecommendationActivity"
            android:exported="false"/>

        <activity android:name=".EditVehicleActivity"
            android:exported="false"/>

        <activity android:name=".ShareHistoryActivity"
            android:exported="false"/>

        <activity android:name=".VehicleComplianceActivity"
            android:exported="false"/>

        <activity android:name=".VinCheckActivity"
            android:exported="false"/>

        <activity android:name=".DocumentViewerActivity"
            android:exported="false"
            android:label="@string/doc_viewer_title"/>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>